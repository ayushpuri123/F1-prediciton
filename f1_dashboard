if schedule.empty:
    st.error("No races were found for the selected season.")
    st.stop()

event_options = {
    f"Round {int(row['RoundNumber'])}: {get_event_name(row)}":
        int(row["RoundNumber"])
    for _, row in schedule.iterrows()
}

selected_event_label = st.sidebar.selectbox(
    "Race prediction event",
    list(event_options.keys()),
)

selected_round = event_options[selected_event_label]


