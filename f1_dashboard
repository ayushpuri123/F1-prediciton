            qualifying_results,
            driver_standings,
        )

        if race_prediction.empty:
            st.warning(
                "No drivers were available for this race prediction."
            )
        else:
            predicted_winner = race_prediction.iloc[0]

            st.success(
                f"🏆 Predicted winner: "
                f"**{predicted_winner['Driver']}** — "
                f"{predicted_winner['WinProbability']:.1%}"
            )

            display_race_prediction = race_prediction[
                [
                    "Driver",
                    "GridPosition",
                    "LapGap",
                    "AveragePoints",
                    "RecentForm",
                    "WinProbability",
                ]
            ].copy()

            display_race_prediction.columns = [
                "Driver",
                "Qualifying Position",
                "Lap Gap",
                "Average Season Points",
                "Recent Points Per Race",
                "Win Probability",
            ]

            st.dataframe(
                display_race_prediction.style.format(
                    {
                        "Lap Gap": "{:.3f}s",
                        "Average Season Points": "{:.2f}",
                        "Recent Points Per Race": "{:.2f}",
                        "Win Probability": "{:.2%}",
                    }
                ),
                use_container_width=True,
                hide_index=True,
            )

            race_chart_data = race_prediction[
                ["Driver", "WinProbability"]
            ].copy()

            race_chart_data["WinProbability"] *= 100

            make_bar_chart(
                race_chart_data,
                category_column="Driver",
                value_column="WinProbability",
                title=(
                    f"Predicted winner probabilities — "
                    f"{selected_event_label}"
