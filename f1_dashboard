def safe_float(value, default: float = 0.0) -> float:
    """Convert a value to float safely."""
    try:
        if pd.isna(value):
            return default
        return float(value)
    except (TypeError, ValueError):
        return default


def normalise_probabilities(values: np.ndarray) -> np.ndarray:
    """Convert positive strength values into probabilities."""
    values = np.asarray(values, dtype=float)
    values = np.nan_to_num(values, nan=0.0, posinf=0.0, neginf=0.0)
    values = np.clip(values, 1e-9, None)

    total = values.sum()

    if total <= 0:
        return np.ones(len(values)) / len(values)

    return values / total


def softmax(values: np.ndarray, temperature: float = 1.0) -> np.ndarray:
    """Stable softmax calculation."""
    values = np.asarray(values, dtype=float)

    if len(values) == 0:
        return values

    temperature = max(float(temperature), 1e-6)
    scaled = values / temperature
    scaled = scaled - np.max(scaled)

    exponentials = np.exp(scaled)
    return exponentials / exponentials.sum()


def clean_team_name(team_name: object) -> str:
    """Return a usable constructor name."""
    if team_name is None or pd.isna(team_name):
        return "Unknown Team"

    name = str(team_name).strip()
    return name if name else "Unknown Team"


def clean_driver_name(row: pd.Series) -> str:
    """Return the best available driver abbreviation."""
    abbreviation = row.get("Abbreviation")

    if abbreviation is not None and not pd.isna(abbreviation):
        abbreviation = str(abbreviation).strip()
        if abbreviation:
            return abbreviation

    driver_number = row.get("DriverNumber")

    if driver_number is not None and not pd.isna(driver_number):
        return str(driver_number)

    return "Unknown"


def get_event_name(row: pd.Series) -> str:
    """Return a consistent event name."""
    for column in ("EventName", "OfficialEventName", "Location", "Country"):
        value = row.get(column)

        if value is not None and not pd.isna(value):
            text = str(value).strip()
            if text:
                return text

    return f"Round {int(row.get('RoundNumber', 0))}"


def make_bar_chart(
    dataframe: pd.DataFrame,
    category_column: str,
    value_column: str,
    title: str,
    x_label: str,
    top_n: int = 15,
) -> None:
    """Display a horizontal bar chart in Streamlit."""
    if dataframe.empty:
        st.info("No data available for this chart.")
        return

    chart_data = dataframe.head(top_n).copy()
    chart_data = chart_data.sort_values(value_column, ascending=True)

    fig, ax = plt.subplots(figsize=(11, 7))
    ax.barh(
        chart_data[category_column].astype(str),
        chart_data[value_column],
    )
    ax.set_title(title)
    ax.set_xlabel(x_label)
    ax.set_ylabel(category_column)
    ax.grid(axis="x", alpha=0.25)

    plt.tight_layout()
    st.pyplot(fig)
    plt.close(fig)


