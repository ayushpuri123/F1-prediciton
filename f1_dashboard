        get_completed_race_data(selected_year, schedule)
    )

completed_rounds = sorted(set(completed_rounds))
total_rounds = len(schedule)
remaining_rounds = max(total_rounds - len(completed_rounds), 0)

driver_standings = calculate_driver_standings(race_results)
constructor_standings = calculate_constructor_standings(
    race_results
)

metric_one, metric_two, metric_three = st.columns(3)

metric_one.metric(
    "Completed races",
